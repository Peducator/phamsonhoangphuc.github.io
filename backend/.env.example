# ---- Cổng server ----
# Backend mặc định 4000 để KHÁC với frontend Next.js (3000).
PORT=4000

# ---- Secret cho route ghi (bắt buộc khi muốn POST/PATCH/DELETE) ----
# Sinh secret đủ mạnh:  openssl rand -hex 32
# Thiếu biến này → mọi route ghi trả 503 (fail-closed, không có giá trị mặc định).
# Ngắn hơn 32 ký tự → server vẫn chạy nhưng cảnh báo; secret yếu thì rate limit cũng không cứu được.
ADMIN_SECRET=

# ---- CORS ----
# Danh sách origin được phép, phân tách bằng dấu phẩy.
# CẢNH BÁO: KHÔNG bao giờ để "*" khi deploy thật — kể cả khi API hiện tại gần như chỉ đọc.
# Hôm nay chưa có cookie/credentials nên "*" có vẻ vô hại, nhưng ngày thêm session là
# nó thành lỗ hổng thật. Giữ danh sách origin cụ thể ngay từ đầu.
CORS_ORIGIN=http://localhost:3000

# ---- Rate limit cho route ghi (chống dò secret) ----
# Chỉ đếm các lần SAI secret; gõ đúng bao nhiêu lần cũng không bị chặn.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# ---- Dữ liệu ----
# Thư mục chứa projects.json / blog.json / profile.json (mặc định: backend/data).
DATA_DIR=./data

# ---- Môi trường ----
NODE_ENV=development

# ---- Reverse proxy (deploy) ----
# CẢNH BÁO: CHỈ set khi thật sự chạy sau proxy (nginx/Caddy/Cloudflare), và ghi đúng số hop.
# Set "true" vô điều kiện là client tự khai được IP giả qua X-Forwarded-For → rate limit mất tác dụng.
# Ví dụ: TRUST_PROXY=1
TRUST_PROXY=
